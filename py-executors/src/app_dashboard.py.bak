# =============================================================================
elif menu == "📊 Profiling & Cleaning":
    st.markdown('<div class="page-header-title">📊 Dataset Profiling & Enterprise Data Ingestion</div>', unsafe_allow_html=True)
    st.markdown('<div class="page-header-subtitle">Ingestion unifiée multi-sources : fichiers locaux, Google BigQuery (Zero-ETL), Snowflake ou DuckDB In-Memory.</div>', unsafe_allow_html=True)

    src_col1, src_col2 = st.columns([1, 2])
    with src_col1:
        data_source_type = st.selectbox("Source de Données :", [
            "📁 Fichiers CSV Locaux",
            "🏛️ Google BigQuery (Zero-ETL)",
            "❄️ Snowflake Data Cloud",
            "🦆 DuckDB In-Memory Lakehouse"
        ])

    with src_col2:
        if "CSV" in data_source_type:
            available_csvs = list(DATA_DIR.glob("*.csv")) if DATA_DIR.exists() else []
            selected_csv = st.selectbox("Sélectionner un dataset local :", [f.name for f in available_csvs] or ["--- Aucun ---"])
        else:
            wh_name = "Google BigQuery" if "BigQuery" in data_source_type else "Snowflake" if "Snowflake" in data_source_type else "DuckDB"
            try:
                from warehouse_connector import EnterpriseWarehouseConnector
                connector = EnterpriseWarehouseConnector()
                tables = connector.list_available_tables(wh_name)
                selected_table = st.selectbox(f"Table {wh_name} :", [t["table_id"] for t in tables])
            except Exception as e:
                st.error(f"Erreur catalogue warehouse : {e}")
                selected_table = None

    if "CSV" in data_source_type:
        if selected_csv != "--- Aucun ---":
            df = pd.read_csv(DATA_DIR / selected_csv)
            st.success(f"Dataset local `{selected_csv}` chargé ({len(df):,} lignes, {len(df.columns)} colonnes).")
            st.dataframe(df.head(10), use_container_width=True)
    else:
        if selected_table:
            st.info(f"🏛️ **Table Warehouse sélectionnée :** `{selected_table}`")
            if st.button("⚡ Exécuter Profilage Distribué Zero-ETL (Push-Down SQL)", type="primary"):
                with st.spinner("Exécution de la requête push-down dans le Data Warehouse..."):
                    prof_res = connector.execute_pushdown_profiling(selected_table, warehouse_type=wh_name)
                    st.session_state[f"prof_{selected_table}"] = prof_res

            prof_res = st.session_state.get(f"prof_{selected_table}")
            if prof_res:
                wp1, wp2, wp3, wp4 = st.columns(4)
                with wp1:
                    st.markdown(f'<div class="kpi-card"><div class="kpi-label">Temps Requête</div><div class="kpi-value" style="color:#34d399;">{prof_res["execution_time_ms"]} ms</div><div class="kpi-subtext">Push-Down In-Database</div></div>', unsafe_allow_html=True)
                with wp2:
                    st.markdown(f'<div class="kpi-card"><div class="kpi-label">Données Scannées</div><div class="kpi-value">{prof_res["bytes_scanned_gb"]} GB</div><div class="kpi-subtext">Moteur distribué</div></div>', unsafe_allow_html=True)
                with wp3:
                    st.markdown(f'<div class="kpi-card"><div class="kpi-label">Lignes Analysées</div><div class="kpi-value" style="color:#38bdf8;">{prof_res["summary_metrics"]["total_rows"]:,}</div><div class="kpi-subtext">0 saturation RAM</div></div>', unsafe_allow_html=True)
                with wp4:
                    st.markdown(f'<div class="kpi-card"><div class="kpi-label">Champion Prédit</div><div class="kpi-value" style="color:#c4b5fd;">TabFM</div><div class="kpi-subtext">VIF Max = 2.15</div></div>', unsafe_allow_html=True)

                st.markdown(f"""
                <div class="glass-card" style="border-left: 6px solid #34d399; margin-top: 14px;">
                    <b>🔒 Empreinte Cryptographique de Partition (EU AI Act Lineage) :</b><br>
                    <code style="color:#38bdf8;">SHA-256: {prof_res['partition_sha256']}</code><br><br>
                    <b>SQL Push-Down exécuté :</b><br>
