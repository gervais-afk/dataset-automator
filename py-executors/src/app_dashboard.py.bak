            st.markdown(f'<div class="kpi-card"><div class="kpi-label">Facteur d\'Économie</div><div class="kpi-value" style="color:#38bdf8;">{summary["cost_reduction_factor"]}</div><div class="kpi-subtext">Efficience certifiée</div></div>', unsafe_allow_html=True)

        st.markdown("##### 🏛️ Hiérarchie de Modèles par Intensité de Charge")
        st.dataframe(pd.DataFrame(MODEL_REGISTRY).T[["tier", "name", "avg_latency_ms", "cost_per_1k_tokens", "role"]], use_container_width=True)
    except Exception as e:
        st.error(f"Erreur Routeur : {e}")


