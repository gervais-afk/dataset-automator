            ["clients.csv (Télécom & Risque de Churn)", "ecommerce_sales_34500.csv (Ventes & LTV)", "diabetes_data_upload.csv (Santé & Dépistage)", "wdbc.csv (Biomédical & Diagnostic)"]
        )
    with d_col2:
        st.markdown("""
        <div style="background:rgba(56,189,248,0.08);border:1px solid rgba(56,189,248,0.3);border-radius:10px;padding:10px;text-align:center;margin-top:14px;">
