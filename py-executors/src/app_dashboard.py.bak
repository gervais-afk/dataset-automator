    #   Gate B : Après Neo4j (étape 2)     → Valider Plan de Feature Engineering
    #   Gate C : Après Gemini (étape 3)    → Valider Stratégie d'Entraînement
    #   Gate D : Après Evaluator (étape 6) → Valider le Modèle Champion
    # ────────────────────────────────────────────────────────────────────────────
    is_multi_hitl = "3" in autonomy_level

    if st.session_state.get("is_running_flow", False) and hitl_gate is None:
        import time
        # Détermination de la prochaine porte selon l'étape courante
