elif menu == "🛡️ Guardrail Intercept Panel":
    st.markdown('<div class="page-header-title">🛡️ Guardrail Intercept Panel — Supervision HITL</div>', unsafe_allow_html=True)
    st.markdown('<div class="page-header-subtitle">Interception in-situ des violations mathématiques. L\'agent se suspend dans l\'état <code>Proposed</code> et attend votre décision.</div>', unsafe_allow_html=True)

    scol1, scol2 = st.columns([2, 1])
    with scol1:
        guardrail_type = st.selectbox("Simuler un type d'alerte :", [
            "VIF — Multicollinéarité Critique (VIF = 14.2 > 10)",
            "GAP — Surapprentissage Détecté (Gap Train/Test = 37% > 20%)",
            "DW  — Autocorrélation Anormale (DW = 0.82 < 1.5)",
            "RCG — Déséquilibre de Classes (Recall Gap = 45% > 30%)",
        ])
    with scol2:
        confidence_score = st.slider("Score de Confiance Agent (%)", 0, 100, 35)

    GR_PARAMS = {
        "VIF": {
            "label": "Multicollinéarité Critique", "icon": "⚠️",
            "metric": "VIF = 14.2", "threshold": "Seuil Max: 10",
            "rationale": "La variable <code>house_age</code> présente un VIF de 14.2 (> 10). Instabilité des coefficients.",
            "branch_a": "🗑 Supprimer la variable <code>house_age</code> et réentraîner",
            "branch_b": "🔧 Appliquer régularisation Ridge (L2)",
            "roi_inf": "+$140.00 / mois", "roi_biz": "+$1,200.00 / an",
        },
        "GAP": {
            "label": "Surapprentissage Détecté", "icon": "🔬",
            "metric": "Gap = 37%", "threshold": "Seuil Max: 20%",
            "rationale": "Accuracy d'entraînement : 0.99 vs test : 0.62 (Gap = 37%). Mémorisation excessive.",
            "branch_a": "✂ Réduire la complexité (max_depth=4) et réentraîner",
            "branch_b": "🔀 Activer TimeSeriesSplit + régularisation",
            "roi_inf": "+$80.00 / mois", "roi_biz": "+$3,500.00 / an",
        },
        "DW": {
            "label": "Autocorrélation des Résidus", "icon": "📈",
            "metric": "DW = 0.82", "threshold": "Seuil: [1.5 – 2.5]",
            "rationale": "Durbin-Watson = 0.82. Dépendance temporelle non capturée.",
            "branch_a": "⏱ Ajouter des features de lag (lag_1, lag_2)",
            "branch_b": "📅 Ajouter des features cycliques (jour, mois)",
            "roi_inf": "+$55.00 / mois", "roi_biz": "+$900.00 / an",
        },
        "RCG": {
            "label": "Déséquilibre de Classes", "icon": "⚖️",
            "metric": "Recall Gap = 45%", "threshold": "Seuil Max: 30%",
            "rationale": "Rappel minorité : 32% vs majorité : 77%. Biais de prédiction.",
            "branch_a": "⬆ Appliquer SMOTE sur la classe minoritaire",
            "branch_b": "⚖ Ajuster class_weight='balanced'",
            "roi_inf": "+$100.00 / mois", "roi_biz": "+$5,000.00 / an",
        },
    }

    key = guardrail_type[:3].strip()
    gr = GR_PARAMS.get(key, GR_PARAMS["VIF"])

    st.markdown(f"""
    <div class="guardrail-panel">
        <div class="guardrail-header">
            <span>{gr["icon"]}</span>
            <span>ALERTE GUARDRAIL : {gr["label"]} [{gr["metric"]}]</span>
            <span class="badge badge-danger" style="margin-left:auto;">{gr["threshold"]}</span>
        </div>
        <div class="guardrail-rationale">🧠 <b>Raisonnement :</b> {gr["rationale"]}</div>
        <div class="decision-branch">
            <div class="decision-node recommended">
                <div style="font-size:0.72rem;font-weight:800;color:#34d399;text-transform:uppercase;">✅ Branche A — Recommandée</div>
                <div style="font-size:0.86rem;color:#e2e8f0;margin-top:4px;">{gr["branch_a"]}</div>
            </div>
            <div class="decision-node alternative">
                <div style="font-size:0.72rem;font-weight:800;color:#a78bfa;text-transform:uppercase;">🔮 Branche B — Alternative</div>
                <div style="font-size:0.86rem;color:#e2e8f0;margin-top:4px;">{gr["branch_b"]}</div>
            </div>
        </div>
    </div>
    """, unsafe_allow_html=True)

    acol1, acol2, acol3 = st.columns(3)
    with acol1:
        if st.button("✅ Valider la Remédiation (Branche A)", type="primary", use_container_width=True):
            st.success("✅ Remédiation appliquée avec succès.")
    with acol2:
        new_thresh = st.number_input("Éditer le seuil in-place :", value=10, min_value=1, max_value=50)
    with acol3:
        if st.button("🔴 Ignorer le Guardrail (Double-Clic)", use_container_width=True):
            st.warning("⚠️ Action consignée avec flag HUMAN_OVERRIDE.")


