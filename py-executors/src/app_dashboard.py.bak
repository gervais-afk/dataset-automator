/* Guardrail Panel */
.guardrail-panel {
    background: linear-gradient(135deg, #1a0d2e 0%, #2d0f3f 100%);
    border: 2px solid #7c3aed; border-radius: 16px; padding: 20px;
    box-shadow: 0 0 30px rgba(124,58,237,0.3), 0 0 60px rgba(239,68,68,0.1);
    animation: guardrailPulse 2s ease-in-out infinite alternate; margin-bottom: 20px;
}
@keyframes guardrailPulse {
    from { box-shadow: 0 0 20px rgba(124,58,237,0.3), 0 0 40px rgba(239,68,68,0.1); }
    to   { box-shadow: 0 0 40px rgba(124,58,237,0.5), 0 0 80px rgba(239,68,68,0.2); }
}
.guardrail-header { font-size:1.1rem; font-weight:800; color:#f87171; display:flex; align-items:center; gap:10px; margin-bottom:14px; }
.guardrail-rationale { background:rgba(0,0,0,0.3); border-left:4px solid #a78bfa; border-radius:0 8px 8px 0; padding:12px 16px; font-size:0.9rem; color:#e2e8f0; margin-bottom:14px; }
.decision-branch { display:flex; gap:12px; align-items:stretch; margin-bottom:14px; }
.decision-node { flex:1; background:rgba(0,0,0,0.25); border:1px solid #374151; border-radius:10px; padding:12px; font-size:0.85rem; }
.decision-node.recommended { border-color:#34d399 !important; background:rgba(52,211,153,0.06) !important; }
.decision-node.alternative  { border-color:#a78bfa !important; background:rgba(167,139,250,0.06) !important; }
.roi-row { display:flex; justify-content:space-between; align-items:center; padding:8px 12px; background:rgba(0,0,0,0.2); border-radius:8px; font-size:0.88rem; margin-bottom:6px; }

/* Flight Recorder & Crypto Panel */
.fr-panel { background:#07101d; border:1px solid #1a2540; border-radius:14px; padding:18px; margin-bottom:20px; }
.fr-header { font-size:0.8rem; font-weight:800; color:#38bdf8; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:12px; display:flex; align-items:center; gap:8px; }
.fr-metric-row { display:flex; justify-content:space-between; align-items:center; padding:6px 0; border-bottom:1px solid #0f1a30; font-size:0.86rem; }
.fr-metric-label { color:#64748b; }
.fr-metric-value { color:#f0f6ff; font-weight:700; font-family:'JetBrains Mono',monospace; }
.fr-metric-value.green  { color:#34d399; }
.fr-metric-value.blue   { color:#38bdf8; }
.fr-metric-value.purple { color:#c4b5fd; }
.fr-metric-value.yellow { color:#fbbf24; }
.trace-log { font-family:'JetBrains Mono',monospace; font-size:0.78rem; background:#04090f; border:1px solid #0f1a30; border-radius:8px; padding:12px; max-height:260px; overflow-y:auto; color:#94a3b8; line-height:1.7; }
.trace-log .ts    { color:#1e3a5f; }
