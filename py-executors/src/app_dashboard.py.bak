            elif hitl_gate == key:
                badges.append(f'<span style="background:#0f2a4a;border:1px solid #38bdf8;color:#38bdf8;padding:4px 12px;border-radius:14px;font-size:0.76rem;font-weight:700;animation:pulse-glow 1.2s infinite;">⏳ Porte {key} · {label}</span>')
            else:
                badges.append(f'<span style="background:#0a1122;border:1px solid #1e3a5f;color:#334155;padding:4px 12px;border-radius:14px;font-size:0.76rem;">· Porte {key} · {label}</span>')
        st.markdown(f"""
        <div style="background:#060c16;border:1px solid #1a2540;border-radius:10px;padding:10px 16px;margin-bottom:14px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
