# =============================================================================
# 1. PIPELINE AGENTIQUE — Canvas SVG Animé + Faded Pruned Nodes
# =============================================================================
if menu == "🎨 Pipeline Agentique (Canvas)":
    st.markdown('<div class="page-header-title">🎨 Pipeline Agentique — Canevas d\'Exécution Spatial</div>', unsafe_allow_html=True)
    st.markdown('<div class="page-header-subtitle">Vue chronologique gauche-droite de l\'orchestration complète avec branches spéculatives, animation de flux et intervention humaine (HITL).</div>', unsafe_allow_html=True)

    # 📂 MODULE D'INGESTION & CHARGEMENT FICHIER (CSV / EXCEL)
    with st.expander("📂 **Charger un nouveau Dataset (CSV ou Excel .xlsx / .xls)**", expanded=True):
        up_col1, up_col2 = st.columns([2, 1])
        with up_col1:
            uploaded_file = st.file_uploader(
                "Déposez votre fichier de données ici :",
                type=["csv", "xlsx", "xls"],
                help="Prend en charge les fichiers CSV, Excel (.xlsx, .xls) de toute taille."
            )
            if uploaded_file is not None:
                try:
                    if uploaded_file.name.endswith(".csv"):
                        df_uploaded = pd.read_csv(uploaded_file)
                    else:
                        df_uploaded = pd.read_excel(uploaded_file)
                    st.session_state.current_df = df_uploaded
                    st.session_state.current_dataset_name = uploaded_file.name
                    st.success(f"✅ Fichier '{uploaded_file.name}' chargé : {df_uploaded.shape[0]} lignes, {df_uploaded.shape[1]} colonnes.")
                except Exception as e:
                    st.error(f"Erreur lors de la lecture du fichier : {e}")
        with up_col2:
            # Sélecteur de dataset par défaut si pas d'upload
            default_ds = st.selectbox(
                "Ou sélectionner un dataset de test :",
                ["clients.csv (Télécom & Churn)", "ecommerce_sales_34500.csv (Finance)", "diabetes_data_upload.csv (Santé)", "wdbc.csv (Biomédical)"]
            )
            if "current_dataset_name" not in st.session_state or uploaded_file is None:
                st.session_state.current_dataset_name = default_ds.split(" ")[0]

    # 🏷️ DÉTECTION DYNAMIQUE DU DOMAINE MÉTIER
    ds_name = st.session_state.get("current_dataset_name", "clients.csv").lower()
    if "client" in ds_name or "telecom" in ds_name:
        detected_domain = "📞 Télécom & Churn Prediction"
        domain_badge_color = "#38bdf8"
        okf_formulas = "ARPU, Charge Shock Ratio (CSR), Customer Lifetime Value (LTV)"
    elif "credit" in ds_name or "finance" in ds_name or "ecom" in ds_name or "sales" in ds_name:
        detected_domain = "💰 Finance & Risque de Crédit"
        domain_badge_color = "#fbbf24"
        okf_formulas = "Debt-to-Income (DTI), Credit Utilization, DSCR Ratio"
    elif "diabet" in ds_name or "wdbc" in ds_name or "obesity" in ds_name:
        detected_domain = "🏥 Santé & Diagnostic Biomédical"
        domain_badge_color = "#34d399"
        okf_formulas = "Indice de Masse Corporelle (IMC), Pression Artérielle Moyenne (MAP)"
    else:
        detected_domain = "📊 Tabulaire Généraliste MLOps"
        domain_badge_color = "#a78bfa"
        okf_formulas = "Ratios non-linéaires, Yeo-Johnson, Encodage cyclique"

    # Bannière du Domaine Détecté
    st.markdown(f"""
    <div style="background:rgba(15,23,42,0.9);border:1px solid {domain_badge_color};border-radius:12px;padding:12px 18px;margin-bottom:18px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">
        <div>
            <span style="font-size:0.75rem;color:#94a3b8;text-transform:uppercase;font-weight:700;">Ontologie Métier Associée :</span>
            <span style="font-size:1.0rem;font-weight:800;color:{domain_badge_color};margin-left:8px;">{detected_domain}</span>
        </div>
        <div style="font-size:0.80rem;color:#cbd5e1;">
            <strong style="color:{domain_badge_color};">Formules OKF v0.2 :</strong> {okf_formulas}
