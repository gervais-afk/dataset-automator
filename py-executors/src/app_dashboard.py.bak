    # 📍 PORTE C — Validation de la Stratégie d'Entraînement (après Gemini Deliberation)
    elif hitl_gate == "C":
        st.markdown("""
        <div class="guardrail-panel" style="margin-bottom:20px;">
            <div class="guardrail-header"><span>⛩️ PORTE C · Validation de la Stratégie d'Entraînement & du Budget Compute</span></div>
            <div class="guardrail-rationale">
                <strong>Délibération Gemini 3.5 Terminée — Recommandation :</strong><br>
