        """, unsafe_allow_html=True)


    # RENDU DU CANEVAS SPATIAL SVG
    def node_style(n):
        if n == stage_idx:   return "#0f2a4a", "#38bdf8"
        elif n < stage_idx:  return "#0a2318", "#34d399"
        else:                return "#0a1122", "#1e3a5f"

    def node_text_color(n):
        if n == stage_idx:   return "#38bdf8"
        elif n < stage_idx:  return "#34d399"
        else:                return "#334155"

    nodes_data = [
        (1,  60,  80,  "📁", "Ingestion",    f"{ds_name[:12]}"),
        (2,  210, 80,  "🕸️", "Neo4j OKF",    f"{detected_domain.split(' ')[1]}"),
        (3,  360, 80,  "🧠", "Gemini 3.5",   "Deliberation"),
        (4,  510, 60,  "⚡", "TabFM",         "Google Champion"),
        (5,  510, 190, "🌲", "XGBoost",       "Challenger"),
        (6,  660, 80,  "⚖️", "Evaluator",     "Judge / HITL"),
        (7,  810, 80,  "📓", "Notebook",      "MLOps Delivery"),
    ]

    svg_parts = []
    for n, x, y, icon, label, sub in nodes_data:
        f, s = node_style(n)
        tc   = node_text_color(n)
        done = "✓ Validé" if n < stage_idx else ""
        ring = ""
        if n == stage_idx:
            ring = (f'<circle cx="{x+60}" cy="{y+35}" r="54" fill="none" stroke="{s}" stroke-width="2.5" opacity="0.6">'
                    f'<animate attributeName="r" values="54;68;54" dur="1.4s" repeatCount="indefinite"/>'
                    f'<animate attributeName="opacity" values="0.6;0;0.6" dur="1.4s" repeatCount="indefinite"/>'
                    f'</circle>')
        node_svg = (f'{ring}'
                    f'<rect x="{x}" y="{y}" width="120" height="70" rx="12" fill="{f}" stroke="{s}" stroke-width="1.8"/>'
                    f'<text x="{x+60}" y="{y+22}" text-anchor="middle" fill="{tc}" font-size="16">{icon}</text>'
                    f'<text x="{x+60}" y="{y+40}" text-anchor="middle" fill="{tc}" font-size="11" font-weight="700">{label}</text>'
                    f'<text x="{x+60}" y="{y+56}" text-anchor="middle" fill="{tc}" font-size="9">{done if done else sub}</text>')
        svg_parts.append(node_svg)

    pruned_svg = ""
    if show_speculative:
        pruned_svg = (
            '<g opacity="0.4">'
            '<path d="M480,115 C495,115 495,290 510,290" fill="none" stroke="#f87171" stroke-width="1.5" stroke-dasharray="4 4"/>'
            '<rect x="510" y="260" width="120" height="60" rx="10" fill="#1f0a0a" stroke="#f87171" stroke-width="1.2"/>'
            '<text x="570" y="282" text-anchor="middle" fill="#f87171" font-size="10" font-weight="700">❌ DeepTree (max=12)</text>'
            '<text x="570" y="300" text-anchor="middle" fill="#94a3b8" font-size="8">Pruné (Overfitting 37%)</text>'
            '</g>'
        )

    def bezier_edge(x1, y1, x2, y2, active, color):
        path_d = f"M{x1},{y1} C{(x1+x2)//2},{y1} {(x1+x2)//2},{y2} {x2},{y2}"
        line = f'<path d="{path_d}" fill="none" stroke="{color}" stroke-width="2.0" stroke-dasharray="6 4" opacity="0.85"/>'
        if active:
            dot = (f'<circle r="6" fill="#38bdf8" opacity="1.0">'
                   f'<animateMotion dur="1.0s" repeatCount="indefinite" path="{path_d}"/></circle>')
            return line + dot
        return line

    edges_svg = ""
    edges_svg += bezier_edge(180, 115, 210, 115, stage_idx == 2, "#38bdf8" if stage_idx == 2 else "#1e3a5f")
    edges_svg += bezier_edge(330, 115, 360, 115, stage_idx == 3, "#38bdf8" if stage_idx == 3 else "#1e3a5f")
    edges_svg += bezier_edge(480, 115, 510,  95, stage_idx == 4, "#38bdf8" if stage_idx == 4 else "#1e3a5f")
    edges_svg += bezier_edge(480, 115, 510, 225, stage_idx == 5, "#a78bfa" if stage_idx == 5 else "#1e3a5f")
    edges_svg += bezier_edge(630,  95, 660, 115, stage_idx == 6, "#34d399" if stage_idx == 6 else "#1e3a5f")
    edges_svg += bezier_edge(630, 225, 660, 115, stage_idx == 6, "#34d399" if stage_idx == 6 else "#1e3a5f")
    edges_svg += bezier_edge(780, 115, 810, 115, stage_idx == 7, "#fbbf24" if stage_idx == 7 else "#1e3a5f")

    mc_badge = ('<rect x="498" y="148" width="134" height="22" rx="6" fill="#1a0d2e" stroke="#7c3aed" stroke-width="1"/>'
                '<text x="565" y="163" text-anchor="middle" fill="#c4b5fd" font-size="9" font-weight="700">⚔ Maker-Checker Arena</text>')

    full_svg = (f'<svg width="960" height="340" xmlns="http://www.w3.org/2000/svg" style="font-family:Inter,sans-serif;">'
                f'<defs><radialGradient id="bg" cx="50%" cy="50%" r="70%">'
                f'<stop offset="0%" stop-color="#0d1b33"/><stop offset="100%" stop-color="#080f1e"/></radialGradient></defs>'
                f'<rect width="960" height="340" rx="14" fill="url(#bg)"/>'
                f'{edges_svg}{mc_badge}{pruned_svg}{"".join(svg_parts)}</svg>')

    st.markdown(f'<div class="pipeline-canvas">{full_svg}</div>', unsafe_allow_html=True)


# =============================================================================
# 1.5. COCKPIT DE DÉCISION MÉTIER & STRATÉGIE
