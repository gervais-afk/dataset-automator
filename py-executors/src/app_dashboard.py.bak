        stage_names = [
            "1 – Ingestion", "2 – Neo4j GraphRAG", "3 – Gemini 3.5 Deliberation",
            "4 – TabFM Training", "5 – XGBoost Training", "6 – Evaluator / Judge", "7 – Notebook Delivery"
