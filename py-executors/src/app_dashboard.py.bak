col_bl, col_br = st.columns([3, 1])
with col_bl:
    st.markdown("""
    <div style="background:#0f1a30;border:1px solid #1a2540;border-radius:12px;padding:12px 20px;margin-bottom:20px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
        <span><span class="dot-live"></span><span style="font-size:0.88rem;color:#e2e8f0;font-weight:700;">Orchestrateur Agentique Actif</span></span>
